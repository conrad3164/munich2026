# Rien de sensible ne doit entrer dans ce dépôt : le programme, les notes et les
# billets vivent dans Firestore, pas ici.
.env
*.pdf
trip.json
private/
.DS_Store

# Identifiants git : ils vivent dans private/, hors de ce dépôt. La règle est là
# par précaution, au cas où le fichier serait un jour déplacé par erreur.
.git-credentials

# Règles Firestore : elles vivent dans private/. Le navigateur n'en a jamais
# besoin, et les publier reviendrait à publier la liste des comptes autorisés.
firestore.rules

# Configuration Firebase en clair : jamais dans ce dépôt. La règle empêche qu'un
# ancien fichier y revienne par mégarde.
#
# config.enc.json, lui, doit être publié : c'est la même configuration, chiffrée
# sous le mot de passe du compte, produite par private/build_config.mjs. C'est
# ce qui permet une première connexion sans joindre le NAS, dont le domaine est
# filtré par certains réseaux d'entreprise.
firebase-config.js
